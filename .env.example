# Base URL of the Next.js Ticket Management System API
# The MCP server forwards all tool calls to this API — it must be reachable.
TMS_API_BASE_URL=http://localhost:3000

# Port this Python MCP server listens on (8001 keeps it separate from the agents-server on 8000)
MCP_SERVER_PORT=8001

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
