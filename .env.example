# MongoDB — same connection string as the Next.js Ticket Management System
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=MyApp

# Database name (Mongoose defaults to "test" when not specified in the URI path)
MONGODB_DB_NAME=test

# Port this Python MCP server listens on (8001 keeps it separate from the agents-server on 8000)
MCP_SERVER_PORT=8001

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
